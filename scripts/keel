#!/usr/bin/env python3
"""Keel CLI — pure-Git multi-executor subagent dispatcher, worktree manager, and branch gate."""

from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys
import tempfile
from typing import Any

sys.dont_write_bytecode = True
SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from keel_lib import KeelError, SCHEMAS_DIR, load_defaults  # noqa: E402
from keel_lib.branch_gate import (  # noqa: E402
    branch_repo_overview,
    compare_rebase,
    evaluate_branch_gate,
    land_branch,
    prepare_branch_write,
    record_branch_write,
    verify_branch,
)
from keel_lib.context import (  # noqa: E402
    assemble_brief,
    generate_run_id,
    load_run_record,
    runs_root_dir,
    save_run_record,
)
from keel_lib.env import is_disposable_verify_path, run_cmd, safe_resolve  # noqa: E402
from keel_lib.executors import EXECUTORS, RunRequest, get_executor  # noqa: E402
from keel_lib.executors.base import (  # noqa: E402
    KeelConfigError,
    KeelExecutionError,
    enforce_verify_min_level,
    normalize_level,
)
from keel_lib.guard_rules import detect_agent_mode  # noqa: E402
from keel_lib.worktree import (  # noqa: E402
    cleanup_worktree,
    create_worktree,
    ensure_agents_dir_ignored,
    git_toplevel,
    list_worktrees,
    validate_slug,
)


def _resolve_project_root(project_arg: str | None) -> Path | None:
    target = Path(project_arg) if project_arg else Path.cwd()
    chk = run_cmd(["git", "rev-parse", "--path-format=absolute", "--show-toplevel"], cwd=target, check=False)
    if chk.returncode == 0 and chk.stdout.strip():
        return safe_resolve(chk.stdout.strip())
    return None


def _effective_caller_mode(project_arg: str | None) -> str:
    cwd_mode = detect_agent_mode(cwd=str(Path.cwd()))
    if cwd_mode != "main":
        return cwd_mode
    if project_arg:
        return detect_agent_mode(cwd=str(Path(project_arg)))
    return "main"


def _cmd_worktree_create(args: argparse.Namespace) -> dict[str, Any]:
    if _effective_caller_mode(args.project) == "read":
        raise KeelError("Read-only subagent mode cannot create worktrees.")
    return create_worktree(
        args.project or Path.cwd(),
        args.slug,
        base=args.base,
        branch=args.branch,
        fetch=args.fetch,
    )


def _cmd_worktree_list(args: argparse.Namespace) -> dict[str, Any]:
    return {"worktrees": list_worktrees(args.project or Path.cwd())}


def _cmd_worktree_cleanup(args: argparse.Namespace) -> dict[str, Any]:
    caller_mode = _effective_caller_mode(args.project)
    if caller_mode == "read":
        raise KeelError("Read-only subagent mode cannot remove worktrees.")
    if args.discard and caller_mode in ("read", "write"):
        raise KeelError("Subagents cannot discard worktrees via `--discard`; return to the main session.")
    proj = git_toplevel(args.project or Path.cwd())
    return cleanup_worktree(proj, args.slug, base=args.base, discard=args.discard)


def _cmd_agent_run(args: argparse.Namespace) -> dict[str, Any]:
    defaults = load_defaults()
    preset = args.preset
    norm_level = normalize_level(args.level)
    if preset == "verify":
        enforce_verify_min_level(norm_level, defaults)
    mode = args.mode or ("write" if preset == "implement" else "read")
    executor_name = args.executor or defaults.get("routing", {}).get(preset, "codex")
    adapter = get_executor(executor_name)

    caller_cwd = safe_resolve(Path.cwd())
    project_root = _resolve_project_root(args.project)
    if project_root is not None:
        ensure_agents_dir_ignored(project_root)

    if args.worktree:
        if project_root is None:
            raise KeelError("--worktree requires running inside or pointing --project at a Git repository.")
        slug = validate_slug(args.worktree)
        wt_dir = project_root / ".agents" / "worktrees" / slug
        if not wt_dir.is_dir():
            create_worktree(project_root, slug, base=args.base)
        workdir = wt_dir
    elif args.cwd:
        workdir = safe_resolve(args.cwd)
    elif project_root is not None:
        workdir = project_root
    else:
        workdir = caller_cwd

    write_target = prepare_branch_write(workdir, mode, norm_level, defaults)
    task_text = args.task or ""
    if args.task_file:
        task_text = Path(args.task_file).read_text(encoding="utf-8")

    run_id = args.run_id or generate_run_id(preset)
    run_dir = runs_root_dir(project_root, Path(tempfile.gettempdir())) / run_id
    run_dir.mkdir(parents=True, exist_ok=True)

    schema_path = safe_resolve(args.schema) if args.schema else (
        (SCHEMAS_DIR / "verdict.schema.json") if preset == "verify" and args.enforce_verdict_schema else None
    )
    output_path = safe_resolve(args.output) if args.output else (
        run_dir / ("verdict.json" if schema_path else "output.md")
    )
    brief_path = run_dir / "brief.md"

    brief_content = assemble_brief(
        why=args.why,
        task=task_text,
        preset=preset,
        mode=mode,
        workdir=workdir,
        project_root=project_root,
        native_agent_docs=adapter.native_agent_docs,
        loads_plugin_spine=adapter.loads_plugin_spine,
        caller_cwd=caller_cwd,
        schema_path=schema_path,
        output_path=output_path,
        inject_schema_in_brief=adapter.inject_schema_in_brief,
    )
    brief_path.write_text(brief_content, encoding="utf-8")

    scratch_verify = is_disposable_verify_path(workdir)
    req = RunRequest(
        run_id=run_id,
        run_dir=run_dir,
        brief_path=brief_path,
        workdir=workdir,
        project_root=project_root,
        mode=mode,
        preset=preset,
        level=norm_level,
        model=args.model,
        effort=args.effort,
        schema_path=schema_path,
        output_path=output_path,
        scratch_verify=scratch_verify,
    )
    record = req.run_record(adapter.name)
    try:
        record.update(adapter.execute(req, defaults))
    except KeelExecutionError as exc:
        save_run_record(run_dir, {**record, **exc.partial})
        raise
    save_run_record(run_dir, record)
    record_branch_write(write_target, adapter.name, record, defaults=defaults)
    return record


def _cmd_agent_resume(args: argparse.Namespace) -> dict[str, Any]:
    defaults = load_defaults()
    project_root = _resolve_project_root(args.project)
    run_dir, record = load_run_record(project_root, args.run_id, Path(tempfile.gettempdir()))
    adapter = get_executor(record["executor"])
    level = normalize_level(args.level) if args.level is not None else None
    effective_level = level or record.get("level")
    if effective_level is not None and record.get("preset") == "verify":
        enforce_verify_min_level(effective_level, defaults)

    write_target = prepare_branch_write(Path(record["workdir"]), record["mode"], effective_level, defaults)
    msg = args.message or ""
    if args.message_file:
        msg = Path(args.message_file).read_text(encoding="utf-8")
    if not msg.strip():
        raise KeelError("Provide --message or --message-file for resume.")

    followup_path = run_dir / f"followup-{generate_run_id('msg')}.md"
    followup_path.write_text(msg.strip() + "\n", encoding="utf-8")
    output_path = safe_resolve(args.output) if args.output else Path(record["output_path"])

    try:
        res = adapter.resume(
            run_dir, record, followup_path, output_path, defaults,
            level=level, model=args.model, effort=args.effort,
        )
    except KeelConfigError:
        followup_path.unlink(missing_ok=True)
        raise
    if level is not None:
        record["level"] = level
    record.update(res)
    save_run_record(run_dir, record)
    record_branch_write(write_target, adapter.name, record, defaults=defaults)
    return record


def _cmd_branch_verify(args: argparse.Namespace) -> dict[str, Any]:
    if _effective_caller_mode(args.project) == "read":
        raise KeelError("Read-only subagent mode cannot run `keel branch verify`.")
    defaults = load_defaults()
    proj = git_toplevel(args.project or Path.cwd())
    return verify_branch(
        project=proj,
        branch_or_slug=args.branch,
        defaults=defaults,
        base=args.base,
        executor=args.executor,
        dual=args.dual,
        level=args.level,
        model=args.model,
        effort=args.effort,
        checks=args.check or (),
        skip_checks=args.skip_checks,
        task_file_arg=args.task_file,
        why=args.why,
        context_file=args.context_file,
        output_dir=args.output_dir,
        force_round=args.force_round,
        caller_cwd=safe_resolve(Path.cwd()),
    )


def _cmd_branch_status(args: argparse.Namespace) -> dict[str, Any]:
    defaults = load_defaults()
    proj = git_toplevel(args.project or Path.cwd())
    max_rounds = int(defaults.get("max_review_rounds", 2))
    levels = tuple(defaults.get("levels", ("L1", "L2", "L3", "L4")))
    verify_min_level = str(defaults.get("verify_min_level", "L2"))
    default_branches = defaults.get("default_branches", ["main", "master"])
    if not args.branch:
        return branch_repo_overview(
            proj,
            base=args.base,
            max_review_rounds=max_rounds,
            levels=levels,
            verify_min_level=verify_min_level,
            default_branches=default_branches,
        )
    return evaluate_branch_gate(
        proj,
        args.branch,
        base=args.base,
        max_review_rounds=max_rounds,
        levels=levels,
        verify_min_level=verify_min_level,
        default_branches=default_branches,
    )


def _cmd_branch_compare(args: argparse.Namespace) -> dict[str, Any]:
    proj = git_toplevel(args.project or Path.cwd())
    return compare_rebase(proj, args.old_base, args.old_head, args.base, args.head)


def _cmd_branch_land(args: argparse.Namespace) -> dict[str, Any]:
    if (args.execute or args.discard) and _effective_caller_mode(args.project) in ("read", "write"):
        raise KeelError("Subagents cannot execute or discard via `keel branch land`; return to the main session.")
    defaults = load_defaults()
    proj = git_toplevel(args.project or Path.cwd())
    strategy = "ff-only" if args.ff_only else "squash"
    return land_branch(
        project=proj,
        branch_or_slug=args.branch,
        defaults=defaults,
        base=args.base,
        strategy=strategy,
        old_base=args.old_base,
        old_head=args.old_head,
        checks=args.check or (),
        skip_checks=args.skip_checks,
        human_override=args.human_override,
        task_file_arg=args.task_file,
        title=args.title,
        keep_branch=args.keep_branch,
        execute=args.execute,
        discard=args.discard,
        discard_reason=args.reason,
    )


class _StrictArgumentParser(argparse.ArgumentParser):
    def __init__(self, *args: Any, **kwargs: Any) -> None:
        kwargs.setdefault("allow_abbrev", False)
        super().__init__(*args, **kwargs)


def build_parser() -> argparse.ArgumentParser:
    parser = _StrictArgumentParser(prog="keel", description="Keel pure-Git multi-executor engineering spine CLI.")
    sub = parser.add_subparsers(dest="domain", required=True, parser_class=_StrictArgumentParser)

    # 1. worktree
    wt = sub.add_parser("worktree", help="Manage isolated .agents/worktrees/<slug> workspaces.")
    wt_sub = wt.add_subparsers(dest="action", required=True, parser_class=_StrictArgumentParser)

    wt_c = wt_sub.add_parser("create", help="Create an isolated git worktree.")
    wt_c.add_argument("slug")
    wt_c.add_argument("--project")
    wt_c.add_argument("--base", default="main")
    wt_c.add_argument("--branch")
    wt_c.add_argument("--fetch", action="store_true", help="Fetch remote base ref before creating worktree.")
    wt_c.set_defaults(func=_cmd_worktree_create)

    wt_l = wt_sub.add_parser("list", help="List git worktrees.")
    wt_l.add_argument("--project")
    wt_l.set_defaults(func=_cmd_worktree_list)

    wt_rm = wt_sub.add_parser("cleanup", help="Safely remove an integrated or discarded worktree.")
    wt_rm.add_argument("slug")
    wt_rm.add_argument("--project")
    wt_rm.add_argument("--base")
    wt_rm.add_argument("--discard", action="store_true")
    wt_rm.set_defaults(func=_cmd_worktree_cleanup)

    # 2. agent
    ag = sub.add_parser("agent", help="Dispatch or resume universal side-agent runs.")
    ag_sub = ag.add_subparsers(dest="action", required=True, parser_class=_StrictArgumentParser)

    ag_r = ag_sub.add_parser("run", help="Assemble context brief and dispatch a side-agent run.")
    ag_r.add_argument("--why", required=True, help="1-3 sentences bridging this task to the project's Core need.")
    ag_r.add_argument("--task", help="Task goal, scope boundaries, and done criteria.")
    ag_r.add_argument("--task-file", help="Read task specification from file.")
    ag_r.add_argument("--preset", default="general", help="Context preset name (general, implement, verify).")
    ag_r.add_argument("--mode", choices=["read", "write"], help="Sandbox/workspace mode.")
    ag_r.add_argument("--executor", choices=sorted(EXECUTORS), help="Side-agent executor adapter.")
    ag_r.add_argument("--level", metavar="L1|L2|L3|L4", help="Required task intensity level.")
    ag_r.add_argument("--model")
    ag_r.add_argument("--effort")
    ag_r.add_argument("--project")
    ag_r.add_argument("--worktree", help="Create/use .agents/worktrees/<slug>.")
    ag_r.add_argument("--base", default="main")
    ag_r.add_argument("--cwd")
    ag_r.add_argument("--schema", help="Optional JSON Schema file path.")
    ag_r.add_argument("--enforce-verdict-schema", action="store_true")
    ag_r.add_argument("--output")
    ag_r.add_argument("--run-id")
    ag_r.set_defaults(func=_cmd_agent_run)

    ag_res = ag_sub.add_parser("resume", help="Resume an existing side-agent run.")
    ag_res.add_argument("run_id")
    ag_res.add_argument("--message")
    ag_res.add_argument("--message-file")
    ag_res.add_argument("--level", metavar="L1|L2|L3|L4", help="Select a new intensity level for this session.")
    ag_res.add_argument("--model", help="Model override for the resumed session.")
    ag_res.add_argument("--effort", help="Reasoning-effort override for the resumed session.")
    ag_res.add_argument("--project")
    ag_res.add_argument("--output")
    ag_res.set_defaults(func=_cmd_agent_resume)

    # 3. branch
    br = sub.add_parser("branch", help="Pure-Git active branch verification, rebase proof, and guarded landing.")
    br_sub = br.add_subparsers(dest="action", required=True, parser_class=_StrictArgumentParser)

    br_v = br_sub.add_parser("verify", help="Run clean-context verification on a local branch in a disposable clone.")
    br_v.add_argument("branch", help="Branch name or worktree slug (e.g., 'pure-git-spine' or 'task/pure-git-spine').")
    br_v.add_argument("--project")
    br_v.add_argument("--base")
    br_v.add_argument("--executor", choices=sorted(EXECUTORS))
    br_v.add_argument("--dual", action="store_true", help="Run both codex and agy independent verifiers.")
    br_v.add_argument("--level", metavar="L1|L2|L3|L4", help="Verifier intensity level.")
    br_v.add_argument("--model")
    br_v.add_argument("--effort")
    br_v.add_argument("--check", action="append", default=[], help="Deterministic shell check to run in disposable clone.")
    br_v.add_argument("--skip-checks", help="Reason for skipping deterministic checks.")
    br_v.add_argument("--task-file", help="Path to active task file (auto-discovered if omitted).")
    br_v.add_argument("--why")
    br_v.add_argument("--context-file")
    br_v.add_argument("--output-dir")
    br_v.add_argument(
        "--force-round",
        action="store_true",
        help="Only for explicit human-authorized escalations after hitting the convergence cap.",
    )
    br_v.set_defaults(func=_cmd_branch_verify)

    br_st = br_sub.add_parser("status", help="Inspect repo-wide task/worktree overview or a branch's gate status.")
    br_st.add_argument("branch", nargs="?")
    br_st.add_argument("--project")
    br_st.add_argument("--base")
    br_st.set_defaults(func=_cmd_branch_status)

    br_cmp = br_sub.add_parser("compare", help="Prove pure-rebase mathematical git-tree equivalence.")
    br_cmp.add_argument("--old-base", required=True)
    br_cmp.add_argument("--old-head", required=True)
    br_cmp.add_argument("--base", required=True)
    br_cmp.add_argument("--head", required=True)
    br_cmp.add_argument("--project")
    br_cmp.set_defaults(func=_cmd_branch_compare)

    br_land = br_sub.add_parser("land", help="Verify branch gates and land (--squash or --ff-only) or --discard.")
    br_land.add_argument("branch")
    br_land.add_argument("--project")
    br_land.add_argument("--base")
    strat_grp = br_land.add_mutually_exclusive_group()
    strat_grp.add_argument("--squash", action="store_true", help="Squash-land branch as 1 atomic commit (default).")
    strat_grp.add_argument("--ff-only", action="store_true", help="Fast-forward merge onto base ref.")
    br_land.add_argument("--old-base")
    br_land.add_argument("--old-head")
    br_land.add_argument("--check", action="append", default=[])
    br_land.add_argument("--skip-checks")
    br_land.add_argument("--human-override")
    br_land.add_argument("--task-file")
    br_land.add_argument("--title")
    br_land.add_argument("--keep-branch", action="store_true")
    br_land.add_argument("--execute", action="store_true")
    br_land.add_argument("--discard", action="store_true")
    br_land.add_argument("--reason", help="Reason when discarding branch via --discard.")
    br_land.set_defaults(func=_cmd_branch_land)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        result = args.func(args)
        print(json.dumps(result, indent=2, ensure_ascii=False))
        return 0
    except KeelError as exc:
        print(f"keel error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
