#!/usr/bin/env python3
"""Dual-protocol PreToolUse guard (Antigravity camelCase + Codex CLI snake_case).

- Auto-binds fresh native Antigravity subagent `conversationId -> (mode, scratch_verify)` via public
  `PreToolUse` `read_file` targets AND `lastUserInput` references to `/.agents/runs/<run_id>/brief.md`
  (parsing backtick-quoted paths first so paths containing spaces bind cleanly), while preserving
  already-established parent sessions so reading `brief.md` from `main` never poisons it.
- Bounded non-blocking stdin read (never stalls if host leaves pipe open after JSON).
- Unconditionally allows non-shell tools (`write_file`, `edit_file`, `read_file`).
- Fails open on internal hook errors so a malformed event never bricks active sessions.
"""

from __future__ import annotations

import fcntl
import json
import os
from pathlib import Path
import re
import select
import sys
import tempfile
from typing import Any

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

from keel_lib.guard_rules import detect_agent_mode, evaluate_command  # noqa: E402

_BACKTICK_BRIEF_RE = re.compile(r"`([^`\r\n]+/\.agents/runs/[^`/\r\n]+/brief\.md)`")
_QUOTED_BRIEF_RE = re.compile(r"""['"]([^'"\r\n]+/\.agents/runs/[^'"/\r\n]+/brief\.md)['"]""")
_BRIEF_PATH_RE = re.compile(r"([^\s`'\"<>()*]+/\.agents/runs/[^/\s`'\"<>()*]+/brief\.md)")
_BRIEF_SUFFIX_RE = re.compile(r"/\.agents/runs/[^/\s`'\"<>()*]+/brief\.md")


def _conv_registry_path() -> Path:
    plugin_data = os.environ.get("PLUGIN_DATA")
    base = Path(plugin_data) if plugin_data else (Path(tempfile.gettempdir()) / f"keel-state-{os.getuid()}")
    base.mkdir(parents=True, exist_ok=True)
    return base / "conv_modes.json"


def _load_conv_registry(reg_path: Path) -> dict[str, Any]:
    if not reg_path.is_file():
        return {}
    try:
        data = json.loads(reg_path.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def _save_conv_registry(reg_path: Path, data: dict[str, Any]) -> None:
    try:
        if len(data) > 256:
            for old_key in list(data.keys())[:-256]:
                data.pop(old_key, None)
        tmp_path = reg_path.with_name(f"{reg_path.name}.{os.getpid()}.tmp")
        tmp_path.write_text(json.dumps(data) + "\n", encoding="utf-8")
        os.replace(tmp_path, reg_path)
    except OSError:
        pass


def _extract_mode_entry(raw_entry: Any) -> tuple[str, bool, bool] | None:
    """Return `(mode, scratch_verify, bound_or_locked)` or None."""
    if isinstance(raw_entry, str) and raw_entry in ("main", "read", "write"):
        return raw_entry, False, True
    if isinstance(raw_entry, dict):
        mode = raw_entry.get("mode")
        if mode in ("main", "read", "write"):
            return mode, bool(raw_entry.get("scratch_verify", False)), bool(raw_entry.get("locked", True))
    return None


def _candidate_brief_paths(
    read_path_str: str | None,
    last_user_input: str | None,
    cwd: str | None,
) -> list[Path]:
    candidates: list[Path] = []
    base = Path(cwd) if cwd else Path.cwd()

    def _add(raw_str: str) -> None:
        p = Path(os.path.expanduser(raw_str))
        resolved = p if p.is_absolute() else (base / p)
        if resolved not in candidates:
            candidates.append(resolved)

    if read_path_str:
        p = Path(os.path.expanduser(read_path_str))
        if p.name == "brief.md":
            _add(read_path_str)
    if last_user_input:
        for pat in (_BACKTICK_BRIEF_RE, _QUOTED_BRIEF_RE):
            for match in pat.findall(last_user_input):
                _add(match)
        # Also extract unquoted absolute/tilde paths containing spaces right before `/.agents/runs/<id>/brief.md`
        for sm in _BRIEF_SUFFIX_RE.finditer(last_user_input):
            end_idx = sm.end()
            line_start = max(last_user_input.rfind("\n", 0, sm.start()) + 1, 0)
            prefix = last_user_input[line_start : sm.start()]
            for pos in range(len(prefix)):
                if prefix[pos] == "/" or prefix[pos : pos + 2] == "~/":
                    if pos == 0 or prefix[pos - 1] in (" ", "\t", "(", "[", ":", "="):
                        _add(last_user_input[line_start + pos : end_idx])
        for match in _BRIEF_PATH_RE.findall(last_user_input):
            _add(match)
    return candidates


def _resolve_or_bind_conv_mode(
    conv_id: str | None,
    cwd: str | None,
    *,
    read_path_str: str | None = None,
    last_user_input: str | None = None,
    is_shell_tool: bool = False,
) -> tuple[str, bool]:
    if not conv_id:
        return detect_agent_mode(cwd=cwd), False

    reg_path = _conv_registry_path()
    lock_path = reg_path.with_name("conv_modes.lock")
    with lock_path.open("a+", encoding="utf-8") as lock_fh:
        fcntl.flock(lock_fh.fileno(), fcntl.LOCK_EX)
        try:
            data = _load_conv_registry(reg_path)
            existing = _extract_mode_entry(data.get(conv_id))
            if existing is not None:
                ex_mode, ex_scratch, ex_locked = existing
                if ex_locked:
                    return ex_mode, ex_scratch

            for brief_path in _candidate_brief_paths(read_path_str, last_user_input, cwd):
                run_json = brief_path.parent / "run.json"
                if run_json.is_file():
                    try:
                        rec = json.loads(run_json.read_text(encoding="utf-8"))
                        mode = rec.get("mode")
                        if rec.get("executor") == "agy" and mode in ("read", "write"):
                            scratch_verify = bool(rec.get("scratch_verify", False))
                            data[conv_id] = {"mode": mode, "scratch_verify": scratch_verify, "locked": True}
                            _save_conv_registry(reg_path, data)
                            return mode, scratch_verify
                    except (OSError, json.JSONDecodeError):
                        continue

            inferred = detect_agent_mode(cwd=cwd)
            inferred_scratch = existing[1] if existing is not None else False
            has_runs_hint = bool(last_user_input and "/.agents/runs/" in last_user_input)
            if is_shell_tool and not has_runs_hint:
                data[conv_id] = {"mode": inferred, "scratch_verify": inferred_scratch, "locked": True}
                _save_conv_registry(reg_path, data)
                return inferred, inferred_scratch
            if existing is None:
                data[conv_id] = {"mode": inferred, "scratch_verify": False, "locked": False}
                _save_conv_registry(reg_path, data)
                return inferred, False
            return existing[0], existing[1]
        finally:
            fcntl.flock(lock_fh.fileno(), fcntl.LOCK_UN)


def _read_stdin_json(timeout_sec: float = 0.25) -> dict[str, Any] | None:
    chunks: list[bytes] = []
    fd = sys.stdin.fileno()
    decoder = json.JSONDecoder()
    while True:
        wait = timeout_sec if not chunks else 0.02
        ready, _, _ = select.select([fd], [], [], wait)
        if not ready:
            break
        chunk = os.read(fd, 65536)
        if not chunk:
            break
        chunks.append(chunk)
        text = b"".join(chunks).decode("utf-8", errors="replace").strip()
        if text:
            try:
                val, end = decoder.raw_decode(text)
                if end == len(text) and isinstance(val, dict):
                    return val
            except json.JSONDecodeError:
                continue
    raw = b"".join(chunks).decode("utf-8", errors="replace").strip()
    if not raw:
        return None
    parsed = json.loads(raw)
    return parsed if isinstance(parsed, dict) else None


def main() -> None:
    event = _read_stdin_json()
    if not event:
        print("{}")
        return

    cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
    conv_id = event.get("conversationId") if isinstance(event.get("conversationId"), str) else None
    last_user_input = event.get("lastUserInput") if isinstance(event.get("lastUserInput"), str) else None

    # 1. Antigravity PreToolUse protocol (camelCase)
    if "toolCall" in event:
        tc = event.get("toolCall")
        if not isinstance(tc, dict):
            print(json.dumps({"decision": "allow"}))
            return
        tool_name = tc.get("name")
        args = tc.get("args") if tc.get("args") is not None else (tc.get("arguments") or {})
        if tool_name == "read_file":
            path_arg = args.get("Path") if isinstance(args, dict) else None
            _resolve_or_bind_conv_mode(
                conv_id,
                cwd,
                read_path_str=path_arg if isinstance(path_arg, str) else None,
                last_user_input=last_user_input,
                is_shell_tool=False,
            )
            print(json.dumps({"decision": "allow"}))
            return
        if tool_name != "run_command":
            _resolve_or_bind_conv_mode(conv_id, cwd, last_user_input=last_user_input, is_shell_tool=False)
            print(json.dumps({"decision": "allow"}))
            return

        mode, _scratch_verify = _resolve_or_bind_conv_mode(
            conv_id, cwd, last_user_input=last_user_input, is_shell_tool=True
        )
        cmd = args.get("CommandLine") if isinstance(args, dict) else None
        reason = evaluate_command(cmd, mode=mode, cwd=cwd) if isinstance(cmd, str) else None
        if reason:
            print(json.dumps({"decision": "deny", "reason": reason}))
        else:
            print(json.dumps({"decision": "allow"}))
        return

    # 2. Codex CLI PreToolUse protocol (snake_case)
    tool_name = event.get("tool_name")
    if tool_name not in ("Bash", "exec_command"):
        print("{}")
        return
    mode = detect_agent_mode(cwd=cwd)
    tool_input = event.get("tool_input")
    cmd = (tool_input.get("command") or tool_input.get("cmd")) if isinstance(tool_input, dict) else None
    reason = evaluate_command(cmd, mode=mode, cwd=cwd) if isinstance(cmd, str) else None
    if reason:
        print(
            json.dumps(
                {
                    "hookSpecificOutput": {
                        "hookEventName": "PreToolUse",
                        "permissionDecision": "deny",
                        "permissionDecisionReason": reason,
                    }
                }
            )
        )
    else:
        print("{}")


if __name__ == "__main__":
    try:
        main()
    except Exception as exc:  # pragma: no cover - defensive fail-open safety net
        print(f"keel pre-tool-use fail-open: {exc!r}", file=sys.stderr)
        print("{}")
